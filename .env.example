# Supabase Dashboard > Connect > Session pooler (persistent Spring Boot API)
# Use the exact host/username shown by Supabase. Do not commit the real password.
DATABASE_URL=jdbc:
DATABASE_USERNAME=postgres.your-project-ref
DATABASE_PASSWORD=replace-with-supabase-database-password
DATABASE_POOL_MAX_SIZE=5
FLYWAY_ENABLED=true
SESSION_COOKIE_SECURE=false
BILLING_WEBHOOK_SECRET=local-dev-change-me
PUBLIC_BASE_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

OBJECT_STORAGE_ENABLED=false
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=masaakis
OBJECT_STORAGE_SECRET_KEY=change-me-now
OBJECT_STORAGE_BUCKET=masaakis-assets

MINIO_ROOT_USER=masaakis
MINIO_ROOT_PASSWORD=change-me-now
NEXT_PUBLIC_API_URL=http://localhost:8080
API_URL=http://localhost:8080
